#!/bin/bash
# Plantilla de configuración local. Copiar a .env.local (ignorado por Git):
#   cp .env.example .env.local && source .env.local
# NUNCA versionar valores reales.

# ---------- Base de datos ----------
export DB_HOST="localhost"
export DB_PORT="3306"
export DB_NAME="colegio"
export DB_USERNAME="cambiar"
export DB_PASSWORD="cambiar"

# ---------- JWT (obligatorio, >= 32 bytes) ----------
# Generar con: openssl rand -base64 64
export JWT_SECRET="generar-con-openssl-rand-base64-64"

# ---------- Administrador inicial (opcional) ----------
# Si no se define, se genera una contraseña aleatoria y se muestra una vez en el log.
export ADMIN_INITIAL_PASSWORD=""

# ---------- Servidor / seguridad ----------
export SERVER_PORT="8080"
export ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
export TRUST_PROXY_HEADERS="false"
export SESSION_TIMEOUT="30m"
