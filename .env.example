# =====================================================================
# Configuración local de REP
#
#   1. Copie este archivo:   cp .env.example .env
#   2. Rellene los valores (sin comillas).
#   3. Arranque normalmente: mvn spring-boot:run
#
# La aplicación lee .env automáticamente. Este archivo está en .gitignore:
# NUNCA versione valores reales.
# =====================================================================

# ---------- JWT (OBLIGATORIO, mínimo 32 caracteres) ----------
# Genere uno con:  openssl rand -base64 48
JWT_SECRET=

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=colegio
DB_USERNAME=admin
DB_PASSWORD=admin

# ---------- Administrador inicial (usuario 22) ----------
# Si se deja vacío se genera una contraseña aleatoria y se muestra una vez en el log.
ADMIN_INITIAL_PASSWORD=

# ---------- Servidor / seguridad ----------
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TRUST_PROXY_HEADERS=false
SESSION_TIMEOUT=30m

# ---------- Inicio de sesión ----------
# Intentos FALLIDOS permitidos por IP antes de bloquear, y minutos de bloqueo.
# (Reiniciar el servidor desbloquea inmediatamente.)
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# ---------- Archivos ----------
# STORAGE_DIR=/ruta/a/uploads
MAX_FILE_SIZE=25MB

# ---------- Datos de demostración ----------
# true = al arrancar con una base vacía crea profesores, estudiantes, actividades,
# entregas con notas y material de estudio. NO usar en producción.
SEED_DEMO=false
