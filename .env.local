#!/bin/bash
# CONFIGURACIÓN LOCAL DE DESARROLLO
# Este archivo contiene variables sensibles - NUNCA commitear a Git
# Ya está en .gitignore

# ============ DATABASE CONFIGURATION ============
export DB_HOST="localhost"
export DB_PORT="3306"
export DB_NAME="colegio"
export DB_USERNAME="admin"
export DB_PASSWORD="admin"

# ============ JWT CONFIGURATION ============
# Generado con: openssl rand -base64 64
# Fecha: 26 enero 2026
export JWT_SECRET="guxs6E+roAhbydKp6hFYVpwoJQbVNV9cOtV6X7VPA9JVG4hKhwwuubMr3ddPJ9kKQqjXu4YplHyKoVhN3u2Dfg=="

# ============ SSL/TLS CONFIGURATION (Para desarrollo local) ============
# En desarrollo: deshabilitado
# En producción: agregar certificado válido
export SSL_KEYSTORE_PATH="/etc/ssl/keystore/tomcat.p12"
export SSL_KEYSTORE_PASSWORD="changeit"
export SSL_KEY_ALIAS="tomcat"

# ============ SERVER CONFIGURATION ============
export SERVER_PORT="8080"

# ============ LOGGING CONFIGURATION ============
export LOG_PATH="./logs"

# ============ SECURITY CONFIGURATION ============
# Para desarrollo: permitir localhost
# Para producción: cambiar a tu dominio
export ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:4200"
export SESSION_TIMEOUT="1800"  # 30 minutos en segundos

# ============ EMAIL CONFIGURATION (opcional, solo si se usa) ============
export MAIL_HOST="smtp.gmail.com"
export MAIL_PORT="587"
export MAIL_USERNAME="tu-email@gmail.com"
export MAIL_PASSWORD="tu-app-password"
export MAIL_FROM="noreply@tu-app.com"

# ============ SPRING PROFILES ============
# Para desarrollo: dev
# Para producción: prod
# export SPRING_PROFILES_ACTIVE="dev"
