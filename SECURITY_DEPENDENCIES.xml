<!-- ========== BUILD PLUGINS PARA SEGURIDAD ========== -->

<!-- Plugin para scanning de dependencias -->
<plugin>
    <groupId>org.owasp</groupId>
    <artifactId>dependency-check-maven</artifactId>
    <version>8.4.2</version>
    <executions>
        <execution>
            <goals>
                <goal>check</goal>
            </goals>
        </execution>
    </executions>
    <configuration>
        <failBuildOnCVSS>7</failBuildOnCVSS>
        <skipProvidedScope>true</skipProvidedScope>
        <skipRuntimeScope>false</skipRuntimeScope>
        <format>ALL</format>
        <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
    </configuration>
</plugin>

<!-- Plugin para análisis estático (SonarQube) -->
<plugin>
    <groupId>org.sonarsource.scanner.maven</groupId>
    <artifactId>sonar-maven-plugin</artifactId>
    <version>3.10.0.2594</version>
</plugin>

<!-- Plugin para validar licencias -->
<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-enforcer-plugin</artifactId>
    <version>3.4.1</version>
    <executions>
        <execution>
            <id>enforce-security</id>
            <goals>
                <goal>enforce</goal>
            </goals>
            <configuration>
                <rules>
                    <!-- Prohibir dependencias inseguras conocidas -->
                    <bannedDependencies>
                        <excludes>
                            <!-- Ejemplo: versiones vulnerables de librerías conocidas -->
                            <!-- Será llenado según vulnerabilidades descubiertas -->
                        </excludes>
                        <message>Dependencia bloqueada por vulnerabilidad conocida</message>
                    </bannedDependencies>
                    <!-- Requerir versiones mínimas -->
                    <requireMavenVersion>
                        <version>[3.6.0,)</version>
                    </requireMavenVersion>
                    <requireJavaVersion>
                        <version>[17,)</version>
                    </requireJavaVersion>
                </rules>
            </configuration>
        </execution>
    </executions>
</plugin>

<!-- ========== USO ========== 
    # Verificar vulnerabilidades en dependencias
    mvn clean dependency-check:check
    
    # Análisis estático con SonarQube
    mvn clean package sonar:sonar -Dsonar.host.url=http://localhost:9000
    
    # Enforzar reglas de seguridad
    mvn clean validate -Dorg.slf4j.simpleLogger.defaultLogLevel=debug
-->