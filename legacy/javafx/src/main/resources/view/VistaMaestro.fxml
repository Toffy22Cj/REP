<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rep.controller.views.ProfesorController"
       stylesheets="@../Styles/maestro.css"
      spacing="20"
      styleClass="tab-content">

    <!-- Selección de materia y curso -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="surface" style="-fx-padding: 20;">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Materia" styleClass="subtitle"/>
            <ComboBox fx:id="materiaComboBox" maxWidth="Infinity" promptText="Seleccione Materia"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Curso" styleClass="subtitle"/>
            <ComboBox fx:id="cursoComboBox" maxWidth="Infinity" promptText="Seleccione Curso"/>
        </VBox>
    </HBox>

    <!-- Crear nueva actividad -->
    <TitledPane text="➕ Nueva Actividad" animated="false">
        <VBox spacing="15" style="-fx-padding: 20;">
            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tipo" styleClass="subtitle"/>
                    <ComboBox fx:id="tipoActividadComboBox" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Título de la Actividad" styleClass="subtitle"/>
                    <TextField fx:id="tituloTextField" promptText="Ej: Examen Final"/>
                </VBox>
            </HBox>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Fecha Límite" styleClass="subtitle"/>
                    <DatePicker fx:id="fechaEntregaPicker" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Duración (minutos)" styleClass="subtitle"/>
                    <TextField fx:id="duracionTextField" promptText="60"/>
                </VBox>
            </HBox>

            <Button fx:id="crearActividadButton" text="Crear Actividad" styleClass="btn-primary" maxWidth="200"/>
            <Label fx:id="statusActividadLabel" styleClass="message-label"/>
        </VBox>
    </TitledPane>

    <!-- Contenido Principal -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="surface" style="-fx-padding: 20;">
        <Label text="📋 Actividades Vigentes" styleClass="subtitle" style="-fx-font-weight: bold;"/>
        <TableView fx:id="actividadesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150"/>
                <TableColumn fx:id="colFecha" text="Entrega" prefWidth="180"/>
                <TableColumn fx:id="colDuracion" text="Duración" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Resultados" onAction="#verResultadosPorActividad" styleClass="button"/>
            <Button text="Editar Preguntas" onAction="#mostrarEditorPreguntas" styleClass="button" style="-fx-background-color: #8b5cf6; -fx-text-fill: white;"/>
            <Button text="Asistencia" onAction="#abrirAsistencia" styleClass="button" style="-fx-background-color: #f59e0b; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</VBox>