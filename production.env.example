#!/bin/bash
# Ejemplo de configuración de variables de entorno para PRODUCCIÓN
# No incluir información sensible real en control de versiones

# ============ DATABASE CONFIGURATION ============
export DB_HOST="db.example.com"
export DB_PORT="3306"
export DB_NAME="colegio_prod"
export DB_USERNAME="colegio_user"
export DB_PASSWORD="GenerarContraseniaSeguraAqui!@#$%"

# ============ JWT CONFIGURATION ============
# Generar con: openssl rand -base64 64
export JWT_SECRET="GenerarClaveJWTSeguraAqui_ConMasDeCaracteres_32Minimo"

# ============ SSL/TLS CONFIGURATION ============
export SSL_KEYSTORE_PATH="/etc/ssl/keystore/tomcat.p12"
export SSL_KEYSTORE_PASSWORD="ContraseñaDelKeystore!@#$%"
export SSL_KEY_ALIAS="tomcat"

# ============ SERVER CONFIGURATION ============
export SERVER_PORT="8443"

# ============ LOGGING CONFIGURATION ============
export LOG_PATH="/var/log/rep"

# ============ SECURITY CONFIGURATION ============
export ALLOWED_ORIGINS="https://app.ejemplo.com,https://admin.ejemplo.com"
export SESSION_TIMEOUT="1800"  # 30 minutos en segundos

# ============ EMAIL CONFIGURATION (para notificaciones) ============
export MAIL_HOST="smtp.gmail.com"
export MAIL_PORT="587"
export MAIL_USERNAME="notificaciones@ejemplo.com"
export MAIL_PASSWORD="ContraseñaAppPassword!@#$%"
export MAIL_FROM="noreply@ejemplo.com"

# ============ BACKUP CONFIGURATION ============
export BACKUP_ENABLED="true"
export BACKUP_SCHEDULE="0 2 * * *"  # Cron: 2 AM diariamente
export BACKUP_RETENTION_DAYS="30"

# ============ MONITORING CONFIGURATION ============
export PROMETHEUS_ENABLED="true"
export METRICS_ENABLED="true"

# Para cargar estas variables:
# source production.env
# java -jar application.jar --spring.profiles.active=prod
