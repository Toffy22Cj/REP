<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rep.controller.views.ResultadosActividadController">
    <center>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="tituloActividadLabel" text="Resultados de Actividad">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
                <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                <javafx.scene.control.Button text="Exportar a Excel" onAction="#exportarExcel"/>
            </HBox>
            
            <TableView fx:id="resultadosTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEstudiante" text="Estudiante" minWidth="200"/>
                    <TableColumn fx:id="colNota" text="Nota" minWidth="100"/>
                    <TableColumn fx:id="colObservaciones" text="Observaciones" minWidth="200"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" minWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
