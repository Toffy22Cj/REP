<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rep.controller.views.AsistenciaController"
      spacing="15"
      alignment="TOP_CENTER"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Control de Asistencia" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <font>
            <Font size="24"/>
        </font>
    </Label>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Curso:"/>
        <ComboBox fx:id="cursoComboBox" promptText="Seleccione Curso" prefWidth="150"/>
        
        <Label text="Materia:"/>
        <ComboBox fx:id="materiaComboBox" promptText="Seleccione Materia" prefWidth="150"/>
        
        <Label text="Fecha:"/>
        <DatePicker fx:id="fechaPicker" prefWidth="120"/>
        
        <Button text="Cargar Lista" onAction="#cargarLista" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <SplitPane dividerPositions="0.25" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <Label text="Historial de Clases" style="-fx-font-weight: bold;"/>
                <ListView fx:id="historialList" VBox.vgrow="ALWAYS"/>
                <Button text="Actualizar Historial" onAction="#cargarHistorial" maxWidth="Infinity"/>
            </VBox>
            
            <TableView fx:id="asistenciaTable">
                <columns>
                    <TableColumn fx:id="estudianteCol" text="Estudiante" prefWidth="250"/>
                    <TableColumn fx:id="estadoCol" text="Estado" prefWidth="150"/>
                    <TableColumn fx:id="observacionCol" text="Observación" prefWidth="300"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </items>
    </SplitPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Label fx:id="statusLabel" text="" style="-fx-font-weight: bold;"/>
        <Button fx:id="guardarButton" text="Guardar Cambios" onAction="#guardarAsistencia"
                style="-fx-background-color: #2Ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 14px; -fx-padding: 8 20 8 20;"/>
    </HBox>
</VBox>
